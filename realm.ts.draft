// Written by shinar realm migrate from realm.yml and dist/manifest.json.
// The handlers run on docker today, and a realm.ts realm is hosted on wasm only.
// Port each handler to wasm/handlers.ts, then rename this file to realm.ts.
// These folders stay files and are read beside realm.ts: actions/, events/, prompts/
// Note: left out realm.yml field category: realm.ts has no field for it.
// Note: left out dist/manifest.json entry 13: realm.ts keys handlers by name, and the name "addLabels" is taken.
// Note: left out dist/manifest.json entry 14: realm.ts keys handlers by name, and the name "ageDays" is taken.
// Note: left out dist/manifest.json entry 15: realm.ts keys handlers by name, and the name "assign" is taken.
// Note: left out dist/manifest.json entry 16: realm.ts keys handlers by name, and the name "close" is taken.
// Note: left out dist/manifest.json entry 17: realm.ts keys handlers by name, and the name "comment" is taken.
// Note: left out dist/manifest.json entry 18: realm.ts keys handlers by name, and the name "daysSinceUpdate" is taken.
// Note: left out dist/manifest.json entry 20: realm.ts keys handlers by name, and the name "isOpen" is taken.
// Note: left out dist/manifest.json entry 22: realm.ts keys handlers by name, and the name "isStale" is taken.
// Note: left out dist/manifest.json entry 24: realm.ts keys handlers by name, and the name "neighbors" is taken.
// Note: left out dist/manifest.json entry 25: realm.ts keys handlers by name, and the name "ref" is taken.
// Note: left out dist/manifest.json entry 26: realm.ts keys handlers by name, and the name "reopen" is taken.
// Note: left out dist/manifest.json entry 27: realm.ts keys handlers by name, and the name "repoRef" is taken.
import { type Realm } from "@embabel/realm-types";

export default {
  name: "github",
  version: "0.5.0",
  host: "wasm",
  description: "GitHub integration — typed via the official OpenAPI 3 spec, so the LLM sees full request AND response types and doesn't have to guess pagination shape, field names, or wrapper-vs-array. Bundles a `github-workflows` Agent Skill that teaches the workflow patterns (search-then-get, paginate safely, common pitfalls) — invaluable for smaller chat models.",
  author: "Rod Johnson",
  url: "https://github.com/embabel-worlds/realm-github",
  tags: ["integrations", "developer-tools", "openapi", "skills"],
  handlers: {
    addLabels: {
      namespace: "issue",
      description: "Add labels (additive; GitHub ignores ones already present).",
      input: {
        type: "array",
        items: {
          type: "string",
        },
      },
      output: {},
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    ageDays: {
      namespace: "issue",
      description: "Days since the issue was opened.",
      input: {
        type: "number",
      },
      output: {
        type: "number",
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    assign: {
      namespace: "issue",
      description: "Assign GitHub logins (additive; GitHub ignores ones already assigned).",
      input: {
        type: "array",
        items: {
          type: "string",
        },
      },
      output: {},
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    close: {
      namespace: "issue",
      description: "Close the issue. `reason` records why (GitHub `state_reason`). Idempotent.",
      input: {
        oneOf: [
          {
            type: "string",
            const: "completed",
          },
          {
            type: "string",
            const: "not_planned",
          },
        ],
      },
      output: {
        type: "object",
        properties: {
          id: {
            type: "number",
          },
          number: {
            type: "number",
          },
          title: {
            type: "string",
          },
          state: {
            type: "string",
          },
          html_url: {
            type: "string",
          },
          updated_at: {
            type: "string",
          },
        },
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    comment: {
      namespace: "issue",
      description: "Add a comment.",
      input: {
        type: "string",
      },
      output: {
        type: "object",
        properties: {
          id: {
            type: "number",
          },
          html_url: {
            type: "string",
          },
          body: {
            type: "string",
          },
        },
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    daysSinceUpdate: {
      namespace: "issue",
      description: "Days since the issue was last touched.",
      input: {
        type: "number",
      },
      output: {
        type: "number",
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    isOpen: {
      namespace: "issue",
      description: "",
      input: {
        type: "object",
        properties: {},
      },
      output: {
        type: "boolean",
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    isStale: {
      namespace: "issue",
      description: "Open and untouched for `days` (default 30) — a candidate for a nudge or close.",
      input: {
        type: "number",
      },
      output: {
        type: "boolean",
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    needsTriage: {
      namespace: "issue",
      description: "Open, no comments, and older than `days` (default 7) — nobody has triaged it.",
      input: {
        type: "number",
      },
      output: {
        type: "boolean",
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    neighbors: {
      namespace: "issue",
      description: "Who/what this entity is connected to, related to, or works with in the knowledge graph. Inherited by every pack type, so a new type is graph- navigable for free. Walks outward `hops` (1–3, default 1); optionally filter relationship types (CSV) and cap with `limit`. Returns the connected nodes nearest-first; empty if this node isn't persisted yet.",
      input: {
        type: "object",
        properties: {
          hops: {
            type: "number",
          },
          relTypes: {
            type: "string",
          },
          limit: {
            type: "number",
          },
        },
      },
      output: {
        type: "array",
        items: {
          type: "object",
          properties: {
            id: {
              type: "string",
            },
            label: {
              type: "string",
            },
            name: {
              type: "string",
            },
            hops: {
              type: "number",
            },
            relPath: {
              type: "array",
              items: {
                type: "string",
              },
            },
          },
          required: ["id", "label", "hops"],
        },
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    ref: {
      namespace: "issue",
      description: "Short human ref, e.g. `octocat/hello-world#42`.",
      input: {
        type: "object",
        properties: {},
      },
      output: {
        type: "string",
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    reopen: {
      namespace: "issue",
      description: "Reopen the issue. Idempotent.",
      input: {
        type: "object",
        properties: {},
      },
      output: {
        type: "object",
        properties: {
          id: {
            type: "number",
          },
          number: {
            type: "number",
          },
          title: {
            type: "string",
          },
          state: {
            type: "string",
          },
          html_url: {
            type: "string",
          },
          updated_at: {
            type: "string",
          },
        },
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    repoRef: {
      namespace: "issue",
      description: "`owner`/`repo` parsed from `html_url`. Throws if it can't be located.",
      input: {
        type: "object",
        properties: {},
      },
      output: {
        type: "object",
        properties: {
          owner: {
            type: "string",
          },
          repo: {
            type: "string",
          },
        },
        required: ["owner", "repo"],
      },
      onType: "GitHubIssue",
      className: "GitHubIssue",
    },
    isDraft: {
      namespace: "pull_request",
      description: "A work-in-progress PR not yet ready for review.",
      input: {
        type: "object",
        properties: {},
      },
      output: {
        type: "boolean",
      },
      onType: "GitHubPullRequest",
      className: "GitHubPullRequest",
    },
    isReadyForReview: {
      namespace: "pull_request",
      description: "Open and out of draft — a reviewer can act on it now.",
      input: {
        type: "object",
        properties: {},
      },
      output: {
        type: "boolean",
      },
      onType: "GitHubPullRequest",
      className: "GitHubPullRequest",
    },
    merge: {
      namespace: "pull_request",
      description: "Merge the PR. `method` selects merge/squash/rebase (default squash).",
      input: {
        type: "object",
        properties: {
          method: {
            oneOf: [
              {
                type: "string",
                const: "merge",
              },
              {
                type: "string",
                const: "squash",
              },
              {
                type: "string",
                const: "rebase",
              },
            ],
          },
          title: {
            type: "string",
          },
          message: {
            type: "string",
          },
        },
      },
      output: {
        type: "object",
        properties: {
          sha: {
            type: "string",
          },
          merged: {
            type: "boolean",
          },
          message: {
            type: "string",
          },
        },
      },
      onType: "GitHubPullRequest",
      className: "GitHubPullRequest",
    },
    requestReviewers: {
      namespace: "pull_request",
      description: "Request reviews from GitHub logins (additive).",
      input: {
        type: "array",
        items: {
          type: "string",
        },
      },
      output: {
        type: "object",
        properties: {
          id: {
            type: "number",
          },
          number: {
            type: "number",
          },
          title: {
            type: "string",
          },
          state: {
            type: "string",
          },
          draft: {
            type: "boolean",
          },
          merged: {
            type: "boolean",
          },
          html_url: {
            type: "string",
          },
          updated_at: {
            type: "string",
          },
        },
      },
      onType: "GitHubPullRequest",
      className: "GitHubPullRequest",
    },
  },
} satisfies Realm;
